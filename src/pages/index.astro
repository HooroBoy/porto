---
import Layout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Dummy data yang mencerminkan karya-karyamu
const featuredProjects = [
	{
		title: "PWL_POS System",
		description: "Sistem kasir komprehensif untuk manajemen stok dan transaksi. Dibangun dengan framework modern untuk efisiensi.",
		tags: ["Laravel", "PHP", "Web App"],
		imageUrl: "https://via.placeholder.com/400x300/111111/4facfe?text=POS+SYS",
		slug: "pwl-pos"
	},
	{
		title: "Lab MMT Launcher",
		description: "Game library launcher lokal yang interaktif. Mampu mengeksekusi file game langsung dari interface web.",
		tags: ["Astro", "Express.js", "Desktop"],
		imageUrl: "https://via.placeholder.com/400x300/111111/ffcc00?text=LAUNCHER",
		slug: "lab-mmt"
	},
	{
		title: "Ice Queen Boss",
		description: "Aset karakter boss 2D dengan animasi spellcasting untuk environment bersalju. Desain berfokus pada palet warna dingin.",
		tags: ["Pixel Art", "Aseprite", "Game Asset"],
		imageUrl: "https://via.placeholder.com/400x300/111111/ffffff?text=ICE+QUEEN",
		slug: "ice-queen"
	}
];
---

<Layout title="Portofolio | Pixel & Code">
	<header class="hero">
		<h1>> HELLO_WORLD</h1>
		<p>Menyusun logika kode yang solid dan merangkai pixel menjadi karya visual.</p>
	</header>

	<section id="projects" class="projects-section">
		<h2 class="section-title">FEATURED_WORK</h2>
		
		<div class="projects-grid">
			{featuredProjects.map((project) => (
				<ProjectCard 
					title={project.title}
					description={project.description}
					tags={project.tags}
					imageUrl={project.imageUrl}
					slug={project.slug}
				/>
			))}
		</div>

		<div class="view-more">
			<button class="btn-pixel" style="background-color: #ffcc00;">LOAD_ARCHIVES.exe</button>
		</div>
	</section>
</Layout>

<style>
	.hero {
		margin: 60px 0;
		border-left: 6px solid var(--primary-color);
		padding-left: 20px;
	}

	.hero h1 {
		font-size: 24px;
		color: var(--secondary-color);
		margin-bottom: 15px;
	}

	.hero p {
		font-size: 12px;
		max-width: 600px;
		line-height: 2;
	}

	.section-title {
		font-size: 18px;
		margin-bottom: 30px;
		display: inline-block;
		border-bottom: 4px solid var(--border-color);
		padding-bottom: 10px;
	}

	.view-more {
		text-align: center;
		margin-top: 50px;
	}
</style>