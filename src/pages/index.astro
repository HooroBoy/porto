---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
---

<MainLayout title="Portfolio | Creative Developer">
  
  <section class="py-20 flex flex-col md:flex-row items-center gap-12">
    <div class="flex-1">
      <h1 class="text-5xl font-bold text-white mb-6 leading-tight">About Me</h1>
      <div class="space-y-4 text-muted-text text-lg max-w-2xl">
        <p>I'm a passionate creative developer and designer with over 5 years of experience building digital products...</p>
        <p>When I'm not coding, you'll find me exploring new design trends or contributing to open-source...</p>
      </div>
    </div>
    <div class="w-64 h-64 relative">
       <div class="absolute inset-0 bg-accent-purple/20 blur-3xl rounded-full"></div>
       <img src="/pixel-cat.png" alt="Avatar" class="relative z-10 w-full h-full object-contain" />
    </div>
  </section>

  <section class="py-20 border-t border-white/5">
    <h2 class="text-3xl font-bold text-white mb-10">Skills & Technologies</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {['Developer', 'Designer', 'Tools'].map((cat) => (
        <div class="bg-card-bg border border-white/5 p-8 rounded-2xl">
          <h3 class="text-white font-bold mb-6">{cat}</h3>
          <div class="flex flex-wrap gap-3">
             {['html', 'css', 'js', 'react', 'astro'].map(s => (
               <span class="px-4 py-1.5 rounded-full border border-white/10 text-xs text-muted-text uppercase">
                 {s}
               </span>
             ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-20 border-t border-white/5">
     <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-white mb-4">My Projects</h2>
        <p class="text-muted-text">A collection of projects I've worked on, ranging from web to mobile.</p>
     </div>
     <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <ProjectCard 
          title="Chat App" 
          description="Real-time communication platform built with modern tech."
          tags={['html', 'tailwind', 'node']}
          image="/project-thumb.jpg"
        />
        </div>
  </section>

  <section class="py-20 border-t border-white/5">
    <h2 class="text-3xl font-bold text-white mb-12">Experience</h2>
    <div class="max-w-3xl">
      <ExperienceItem 
        year="2025" 
        role="Senior Developer" 
        company="Lorem Ipsum" 
        description="Membangun arsitektur frontend yang scalable dan memimpin tim developer."
      />
      <ExperienceItem 
        year="2024" 
        role="Frontend Engineer" 
        company="Digital Agency" 
        description="Bertanggung jawab atas implementasi UI/UX yang responsif dan performan."
      />
    </div>
  </section>

</MainLayout>