---
const { year, role, company, description } = Astro.props;
---
<div class="relative pl-12 pb-12 last:pb-0 group">
  <div class="absolute left-[19px] top-0 bottom-0 w-[2px] bg-white/10 group-last:bg-transparent"></div>
  
  <div class="absolute left-0 top-0 w-10 h-10 rounded-full bg-accent-purple flex items-center justify-center text-[12px] font-bold text-white shadow-[0_0_15px_rgba(139,92,246,0.5)] z-10">
    {year}
  </div>

  <div class="bg-card-bg border border-white/5 p-6 rounded-2xl">
    <h3 class="text-xl font-bold text-white">{role}</h3>
    <p class="text-accent-purple text-sm mb-3">at {company}</p>
    <p class="text-muted-text text-sm leading-relaxed">{description}</p>
  </div>
</div>