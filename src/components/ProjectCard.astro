---
interface Props {
	title: string;
	description: string;
	tags: string[];
	imageUrl: string;
	slug: string;
}

const { title, description, tags, imageUrl, slug } = Astro.props;
---

<div class="project-card pixel-border">
	<div class="image-container">
		<img src={imageUrl} alt={title} class="pixel-img" />
	</div>
	<div class="content">
		<h3>{title}</h3>
		<p>{description}</p>
		<div class="tags">
			{tags.map((tag) => (
				<span class="tag">{tag}</span>
			))}
		</div>
		<a href={`/projects/${slug}`} class="btn-pixel">VIEW DETAILS_</a>
	</div>
</div>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		margin-bottom: 30px;
		background-color: #1a1a1a;
	}

	@media (min-width: 768px) {
		.project-card {
			flex-direction: row;
		}
	}

	.image-container {
		flex: 1;
		border-bottom: 4px solid #fff;
		background-color: #333;
		min-height: 200px;
	}

	@media (min-width: 768px) {
		.image-container {
			border-bottom: none;
			border-right: 4px solid #fff;
			max-width: 350px;
		}
	}

	.pixel-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		image-rendering: pixelated; /* Penting untuk estetika pixel art */
	}

	.content {
		flex: 2;
		padding: 20px;
	}

	h3 {
		color: var(--primary-color);
		font-size: 16px;
		margin-bottom: 15px;
	}

	p {
		font-size: 10px;
		line-height: 1.8;
		margin-bottom: 20px;
		color: #ccc;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 20px;
	}

	.tag {
		background-color: #333;
		border: 2px solid #666;
		padding: 5px 8px;
		font-size: 8px;
	}
</style>