---
const { title, description, tags, image } = Astro.props;
---
<div class="bg-card-bg border border-white/5 rounded-2xl overflow-hidden hover:border-accent-purple/50 transition-all group">
  <div class="aspect-video w-full bg-stone-800 overflow-hidden">
    <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
  </div>
  <div class="p-6">
    <h3 class="text-xl font-bold text-white mb-2">{title}</h3>
    <p class="text-muted-text text-sm mb-4 line-clamp-2">{description}</p>
    
    <div class="flex flex-wrap gap-2 mb-6">
      {tags.map((tag) => (
        <span class="text-[10px] uppercase tracking-wider px-2 py-1 rounded-full border border-accent-purple/30 text-accent-purple bg-accent-purple/5">
          {tag}
        </span>
      ))}
    </div>

    <div class="flex gap-3">
      <a href="#" class="flex-1 text-center bg-accent-purple hover:bg-accent-purple/90 text-white py-2 rounded-lg text-sm font-medium transition-colors">
        View Details
      </a>
      <button class="px-3 border border-white/10 rounded-lg hover:bg-white/5">
         <span class="sr-only">Github</span>
         </button>
    </div>
  </div>
</div>