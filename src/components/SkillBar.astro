---
const { name, level, color = "bg-cyan-400", note } = Astro.props;
---
<div class="mb-4">
  <div class="flex justify-between items-end mb-1">
    <span class="tracking-wide">{name}</span>
    <span class="text-sm text-stone-400">{note}</span>
  </div>
  <div class="h-5 bg-stone-900 w-full border-2 border-stone-800 p-[2px]">
    <div class={`h-full ${color}`} style={`width: ${level}%;`}></div>
  </div>
</div>